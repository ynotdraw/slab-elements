---
import ShowcaseCards from '../../components/ShowcaseCards.astro';
import Base from '../../layouts/Base.astro';

const summary =
  'The same headless Slab elements under completely different designs. Each theme is one stylesheet of ::part() and :state() selectors.';
---

<Base description={summary} title="Showcase · Slab">
  <div class="page">
    <header class="intro">
      <p class="eyebrow">Showcase</p>
      <h1>One set of elements, any look</h1>
      <p>
        Slab ships behavior, not a look. Each page here uses the headless
        elements exactly as they ship, styled from the outside with
        <code>::part()</code> and <code>:state()</code>, in one stylesheet you
        can read under the demo.
      </p>
    </header>

    <ShowcaseCards />
  </div>
</Base>

<style>
  .page {
    display: grid;
    gap: 2.5rem;
    margin-inline: auto;
    max-inline-size: 78rem;
    padding: 1.5rem var(--gutter) 4rem;
  }

  .intro {
    border-block-end: 4px solid var(--ink);
    display: grid;
    gap: 0.75rem;
    max-inline-size: 52rem;
    padding-block-end: 1.5rem;

    h1 {
      font-size: clamp(2.25rem, 6vw, 3.5rem);
      font-weight: 700;
      letter-spacing: -0.02em;
      line-height: 1;
      margin: 0;
    }

    p {
      margin: 0;
    }
  }
</style>
