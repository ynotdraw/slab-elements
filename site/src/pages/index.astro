---
import CodeBlock from '../components/CodeBlock.astro';
import Logo from '../components/Logo.astro';
import Base from '../layouts/Base.astro';
import { componentsByGroup, description } from '../lib/index-markdown.ts';
import { inline } from '../lib/prose.ts';

const base = import.meta.env.BASE_URL;
const components = (await componentsByGroup()).flatMap(({ components }) => components);

const installs = [
  { command: 'pnpm add slab-elements lit', name: 'pnpm' },
  { command: 'npm install slab-elements lit', name: 'npm' },
];

// The same Disclosure in each, from its label to listening for "toggle".
const frameworks = [
  {
    code: `<script type="module">
  import 'slab-elements/disclosure.js';
</script>

<slab-disclosure label="Foundation">
  Poured once, built on forever.
</slab-disclosure>

<style>
  slab-disclosure::part(summary) {
    font-weight: 600;
  }

  slab-disclosure[open]::part(summary) {
    color: #b3381a;
  }
</style>`,
    file: 'index.html',
    lang: 'html',
    name: 'HTML',
    note: 'Any bundler (or an import map) takes care of the imports.',
  },
  {
    code: `import 'slab-elements/disclosure.js';
import { useEffect, useRef } from 'react';

export function Foundation({ onToggle }) {
  const disclosure = useRef(null);

  useEffect(() => {
    const element = disclosure.current;
    const listener = (event) => onToggle(event.newState === 'open');

    element.addEventListener('toggle', listener);
    return () => element.removeEventListener('toggle', listener);
  }, [onToggle]);

  return (
    <slab-disclosure label="Foundation" ref={disclosure}>
      Poured once, built on forever.
    </slab-disclosure>
  );
}`,
    file: 'Foundation.jsx',
    lang: 'jsx',
    name: 'React',
    note: 'The tag is the component. No wrapper package. Events go through a ref.',
  },
  {
    code: `<script setup>
import 'slab-elements/disclosure.js';
import { ref } from 'vue';

const open = ref(false);
</script>

<template>
  <slab-disclosure
    label="Foundation"
    :open="open"
    @toggle="open = $event.newState === 'open'"
  >
    Poured once, built on forever.
  </slab-disclosure>
</template>`,
    file: 'Foundation.vue',
    lang: 'vue',
    name: 'Vue',
    note: "Let Vue's compiler know slab- tags are custom elements with isCustomElement.",
  },
  {
    code: `<script>
  import 'slab-elements/disclosure.js';

  let open = $state(false);
</script>

<slab-disclosure
  label="Foundation"
  {open}
  ontoggle={(event) => (open = event.newState === 'open')}
>
  Poured once, built on forever.
</slab-disclosure>`,
    file: 'Foundation.svelte',
    lang: 'svelte',
    name: 'Svelte',
    note: 'Svelte binds properties and events to custom elements like any other element.',
  },
] as const;
// One headless <slab-switch>, four ways. Each look is the CSS a consumer would
// write, from outside, with only ::part() and :state(). The page runs exactly
// that CSS, scoped to its card, so what's shown is what's running.
const looks = [
  {
    id: 'ships',
    title: 'As it ships',
    label: 'Vapor barrier',
    css: `/* Nothing. That's the point. */`,
  },
  {
    id: 'brick',
    title: 'Brick',
    label: 'Slow cool',
    css: `slab-switch {
  align-items: center;
  display: flex;
  gap: 1rem;
  justify-content: space-between;
}

slab-switch::part(input) {
  appearance: none;
  background:
    linear-gradient(#1c1c1c, #1c1c1c) no-repeat 0.25rem 50% / 1.125rem 1.125rem,
    #fff;
  block-size: 1.75rem;
  border: 2px solid #1c1c1c;
  inline-size: 3.25rem;
  margin: 0;
  transition: background 150ms;
}

slab-switch:state(checked)::part(input) {
  background:
    linear-gradient(#fff, #fff) no-repeat calc(100% - 0.25rem) 50% / 1.125rem 1.125rem,
    #d9492a;
}

slab-switch::part(input):focus-visible {
  outline: 3px solid #d9492a;
  outline-offset: 2px;
}`,
  },
  {
    id: 'soft',
    title: 'Soft',
    label: 'Wire mesh',
    css: `slab-switch {
  align-items: center;
  display: flex;
  font-family: system-ui, sans-serif;
  gap: 0.75rem;
}

slab-switch::part(switch) {
  display: flex;
  order: -1;
}

slab-switch::part(input) {
  appearance: none;
  background:
    radial-gradient(circle, #fff 0 0.55rem, transparent 0.6rem)
      no-repeat 0.2rem 50% / 1.3rem 1.3rem,
    #767676;
  block-size: 1.7rem;
  border-radius: 999px;
  inline-size: 3rem;
  margin: 0;
  transition: background 200ms;
}

slab-switch:state(checked)::part(input) {
  background:
    radial-gradient(circle, #fff 0 0.55rem, transparent 0.6rem)
      no-repeat calc(100% - 0.2rem) 50% / 1.3rem 1.3rem,
    #2563eb;
}

slab-switch::part(input):focus-visible {
  outline: 2px solid #2563eb;
  outline-offset: 2px;
}`,
  },
  {
    id: 'thin',
    title: 'Thin',
    label: 'Pump truck',
    css: `slab-switch {
  align-items: center;
  display: flex;
  gap: 1rem;
  justify-content: space-between;
}

slab-switch::part(switch) {
  align-items: center;
  display: flex;
  position: relative;
}

/* The track. The input is still what's clicked and focused. */
slab-switch::part(input) {
  appearance: none;
  background: #767676;
  block-size: 0.875rem;
  border-radius: 999px;
  inline-size: 2.5rem;
  margin: 0;
}

/* The thumb, on the input's wrapper. */
slab-switch::part(switch)::after {
  background: #fff;
  block-size: 1.375rem;
  border-radius: 50%;
  box-shadow: 0 1px 3px rgb(0 0 0 / 50%);
  content: '';
  inline-size: 1.375rem;
  inset-inline-start: -0.125rem;
  pointer-events: none;
  position: absolute;
  transition: translate 150ms;
}

slab-switch:state(checked)::part(input) {
  background: #9d8fd6;
}

slab-switch:state(checked)::part(switch)::after {
  background: #5b3fc4;
  translate: 1.375rem;
}

slab-switch::part(input):focus-visible {
  outline: 2px solid #5b3fc4;
  outline-offset: 6px;
}`,
  },
];

// Each look's CSS, run only in its own card.
const scoped = (id: string, css: string) =>
  css.replaceAll(/(^|,\s*)slab-switch/gm, `$1.look-${id} slab-switch`);

---

<Base
  description="Headless Web Components. Slab handles keyboard, focus, ARIA, and forms on top of native elements. What it looks like is up to you."
  markdown="index.md"
  title="Slab · Headless Web Components"
>
  <section aria-labelledby="hero" class="split hero">
    <div class="hero-copy">
      <p class="eyebrow">Headless Web Components</p>
      <h1 id="hero">The foundation<br />is not the finish.</h1>
      <p class="lead">
        Slab handles the hard parts of a component — keyboard and focus, ARIA,
        forms, events — on top of the native elements browsers already ship.
        What it looks like? That's all you, in React, Vue, Svelte, Rails, or
        plain HTML.
      </p>

      <slab-tabs class="install" label="Package manager">
        {installs.map(({ name }) => <slab-tabs-tab panel={name}>{name}</slab-tabs-tab>)}
        {
          installs.map(({ command, name }) => (
            <slab-tabs-panel name={name}>
              <div class="command">
                <code>{command}</code>
                <button class="copy" data-copy={command} type="button">
                  Copy
                </button>
              </div>
            </slab-tabs-panel>
          ))
        }
      </slab-tabs>
      <p aria-live="polite" class="visually-hidden" data-copy-status></p>

      <div class="ctas">
        <a class="button button--primary" href={`${base}components/`}>Browse the components</a>
        <a class="button" href="#usage">See how it works</a>
      </div>
    </div>

    <div class="hero-diagram">
      <div class="layers" role="img" aria-label="Your styles and markup, in any framework, sit on Slab, which sits on native HTML elements.">
        <p class="layer-label">Any framework, or none</p>
        <div class="frameworks">
          <div class="course">
            <span>React</span>
            <span>Vue</span>
            <span>Svelte</span>
          </div>
          <span>Plain HTML</span>
          <p class="layer-label">Your styles · your markup</p>
        </div>

        <p class="layer-label">Slab custom elements</p>
        <div class="slab">
          <div class="course">
            <span>State</span>
            <span>ARIA</span>
          </div>
          <div class="course course--staggered">
            <span>Keys</span>
            <span>Focus · forms</span>
          </div>
          <span class="base">Native HTML elements</span>
        </div>
      </div>

      <dl class="specs">
        <div>
          <dt>Tested in</dt>
          <dd>Chromium · Firefox · WebKit</dd>
        </div>
        <div>
          <dt>Types</dt>
          <dd>TypeScript declarations</dd>
        </div>
      </dl>
    </div>
  </section>

  <section aria-labelledby="why" class="split why" id="why">
    <h2 class="visually-hidden">Why headless</h2>
    <div>
      <h3><span>01</span> Bring your own design</h3>
      <p>
        No visual CSS, so no theme to fight. Style every piece with
        <code>::part()</code> and every state with <code>:state()</code>.
      </p>
    </div>
    <div>
      <h3><span>02</span> The platform first</h3>
      <p>
        A Slab dialog is a <code>&lt;dialog&gt;</code>. A switch is a checkbox.
        We only fill in what browsers don't already do.
      </p>
    </div>
    <div>
      <h3><span>03</span> Built to last</h3>
      <p>
        Custom elements are a web standard, and browsers cook low and slow,
        like a good brisket. Whatever framework you're using in three years
        will still render these tags.
      </p>
    </div>
  </section>

  <section aria-labelledby="looks-heading" class="looks" id="looks">
    <div class="looks-intro">
      <p class="eyebrow">Make it yours</p>
      <h2 id="looks-heading">One element. Any look.</h2>
      <p>
        Every switch below is the same <code>&lt;slab-switch&gt;</code>. Only
        the CSS differs, and none of it ships with Slab.
      </p>
    </div>

    <ul class="look-grid">
      {
        looks.map(({ css, id, label, title }) => (
          <li class={`look look-${id}`}>
            <Fragment set:html={`<style>${scoped(id, css)}</style>`} />
            <h3>{title}</h3>
            <div class="look-stage">
              <slab-switch checked label={label} />
            </div>
            <details class="look-css">
              <summary>The CSS</summary>
              <CodeBlock code={css} lang="css" />
            </details>
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="usage-heading" class="split usage" id="usage">
    <div class="usage-copy">
      <p class="eyebrow">Usage</p>
      <h2 id="usage-heading">Behavior in. Design yours.</h2>
      <p>
        Import the elements you need, drop them in like any other tag, and
        style them however you want.
      </p>
    </div>

    <slab-tabs class="frameworks-tabs" label="Framework">
      {frameworks.map(({ name }) => <slab-tabs-tab panel={name}>{name}</slab-tabs-tab>)}
      {
        frameworks.map(({ code, file, lang, name, note }) => (
          <slab-tabs-panel name={name}>
            <CodeBlock code={code} lang={lang} />
            <p class="code-note">
              <span>{file}</span> {note}
            </p>
          </slab-tabs-panel>
        ))
      }
    </slab-tabs>
  </section>

  <section aria-labelledby="elements" class="elements">
    <div class="elements-heading">
      <h2 id="elements">{components.length} elements</h2>
    </div>
    <ul class="element-grid">
      {
        components.map((component) => (
          <li>
            <a href={`${base}components/${component.id}/`}>
              <span>&lt;{component.data.tags[0]}&gt;</span>
              <span set:html={inline(component.data.element)} />
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="cta" class="cta">
    <Logo size={76} />
    <h2 id="cta">Pour the foundation once.</h2>
    <p>
      Then build your Design System on top of it — in whatever framework you're
      using this year, and the next one.
    </p>
    <div class="ctas">
      <a class="button button--primary" href={`${base}get-started/`}>Get started</a>
      <a class="button" href="https://github.com/ynotdraw/slab-elements">View the source</a>
    </div>
  </section>

  <p class="visually-hidden">{description}</p>
</Base>

<script>
  // The install and framework switchers are Slab's own headless Tabs,
  // styled below through `::part()` and `:state()`.
  //
  // Imported dynamically. Slab's `package.json` declares only `dist` as
  // having side effects, which is right for the package, but a bundler applies
  // it to `src` too and drops a bare import of a component as unused. A
  // dynamic import is never dropped.
  void Promise.all([
    import('../../../src/tabs.ts'),
    import('../../../src/tabs.panel.ts'),
    import('../../../src/tabs.tab.ts'),
    import('../../../src/switch.ts'),
  ]);

  // On every visit to the page, since each brings new buttons.
  document.addEventListener('astro:page-load', () => {
    const status = document.querySelector('[data-copy-status]');

    for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
      let timeout: ReturnType<typeof setTimeout>;

      button.addEventListener('click', async () => {
        await navigator.clipboard?.writeText(button.dataset.copy ?? '');
        button.textContent = 'Copied';

        if (status) {
          status.textContent = 'Copied!';
        }

        clearTimeout(timeout);

        timeout = setTimeout(() => {
          button.textContent = 'Copy';

          if (status) {
            status.textContent = '';
          }
        }, 1600);
      });
    }
  });
</script>

<style>
  /*
    Columns divided by rules that hold however they wrap: the rules are the
    ink behind a 3px gap, so a stacked layout on a phone is divided the same.
  */
  .split {
    background-color: var(--ink);
    border-block-end: 3px solid var(--ink);
    display: grid;
    gap: 3px;
  }

  .split > * {
    background-color: var(--page);
    min-inline-size: 0;
  }

  .hero {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: 1.625rem;
    padding: clamp(2.5rem, 7vw, 4rem) var(--gutter) 3.5rem;
  }

  h1 {
    font-size: clamp(2.75rem, 7vw, 5.25rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 0.96;
    margin: 0;
    text-wrap: balance;
  }

  .lead {
    font-size: 1.25rem;
    line-height: 1.4;
    margin: 0;
    max-inline-size: 46ch;
  }

  /*
    Before Tabs is registered, its tabs sit in a row as they will in its
    tablist, the first selected, and only the first panel shows. So nothing
    moves or changes when it is.
  */
  slab-tabs:not(:defined) slab-tabs-panel + slab-tabs-panel {
    display: none;
  }

  .install:not(:defined) {
    display: flex;
    flex-wrap: wrap;

    /* The tablist's border, which is open at the bottom. */
    > slab-tabs-tab {
      border-block-start: 1px solid var(--ink);
    }

    > slab-tabs-tab:first-of-type {
      background-color: var(--ink);
      border-inline-start: 1px solid var(--ink);
      color: var(--paper);
    }

    > slab-tabs-tab:last-of-type {
      border-inline-end: 1px solid var(--ink);
    }

    > slab-tabs-panel {
      flex-basis: 100%;
    }
  }

  .install {
    max-inline-size: 32rem;
  }

  .install::part(tablist) {
    border: 1px solid var(--ink);
    border-block-end: 0;
    display: flex;
    inline-size: fit-content;
  }

  .install slab-tabs-tab {
    background-color: var(--paper);
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 0.5rem 1rem;

    & + slab-tabs-tab {
      border-inline-start: 1px solid var(--ink);
    }

    &:state(selected) {
      background-color: var(--ink);
      color: var(--paper);
    }

    &:focus-visible {
      outline: 3px solid var(--ember);
      outline-offset: 2px;
    }
  }

  .install slab-tabs-panel:focus-visible {
    outline: 3px solid var(--ember);
    outline-offset: 2px;
  }

  .command {
    align-items: stretch;
    background-color: var(--paper);
    border: 3px solid var(--ink);
    display: flex;

    code {
      background: none;
      border: 0;
      flex: 1;
      font-size: 0.9375rem;
      min-inline-size: 0;
      overflow-x: auto;
      padding: 0.875rem 1rem;
      white-space: nowrap;
    }
  }

  .copy {
    background-color: var(--ink);
    border: 0;
    border-inline-start: 3px solid var(--ink);
    color: var(--paper);
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 0 1.125rem;

    &:hover {
      background-color: var(--ember-deep);
    }

    &:focus-visible {
      outline-offset: -6px;
      outline-color: var(--paper);
    }
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;

    .button {
      font-size: 1.0625rem;
      padding: 0.875rem 1.5rem;
    }
  }

  /* The stack the elements sit in: your code, Slab, the platform. */
  .hero .hero-diagram {
    background-color: var(--ink);
    color: var(--paper);
    /* Ink in either theme, like the code. */
    color-scheme: light;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    justify-content: space-between;
    padding: 3.5rem var(--gutter);
  }

  .layers {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-inline: auto;
    max-inline-size: 26rem;
    inline-size: 100%;
  }

  .layer-label {
    color: var(--dim);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    margin: 0;
  }

  .frameworks {
    border: 3px dashed #6b6b64;
    display: grid;
    gap: 0.5625rem;
    padding: 1rem;

    span {
      background-color: #33332f;
      color: #b5b5ad;
      display: grid;
      font-family: var(--font-mono);
      font-size: 0.6875rem;
      min-block-size: 1.875rem;
      place-items: center;
    }
  }

  .course {
    display: flex;
    gap: 0.5625rem;

    span {
      flex: 1;
    }
  }

  .slab {
    display: grid;
    gap: 0.5625rem;

    span {
      align-items: center;
      background-color: var(--paper);
      color: var(--ink);
      display: flex;
      font-family: var(--font-mono);
      font-size: 0.6875rem;
      min-block-size: 2.125rem;
      padding: 0 0.75rem;
      white-space: nowrap;
    }

    /* Deep ember, since the logo's is short of 4.5:1 with text this size. */
    .base {
      background-color: var(--ember-deep);
      color: var(--paper);
    }
  }

  /* The logo's second course: a short brick, then a long one. */
  .course--staggered span:first-child {
    flex: 0 0 26%;
  }

  .specs {
    border-block-start: 1px solid var(--rule-on-ink);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    margin: 0 auto;
    max-inline-size: 26rem;
    inline-size: 100%;

    div {
      border-block-end: 1px solid var(--rule-on-ink);
      display: flex;
      flex-wrap: wrap;
      gap: 0.25rem 1rem;
      justify-content: space-between;
      padding: 0.8125rem 0;
    }

    div:last-child {
      border-block-end: 0;
    }

    dt {
      color: var(--dim);
    }

    dd {
      margin: 0;
      text-align: end;
    }
  }

  .why {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));

    > div {
      display: flex;
      flex-direction: column;
      gap: 0.8125rem;
      padding: 2.625rem var(--gutter);
    }

    h3 {
      align-items: baseline;
      display: flex;
      font-size: 1.625rem;
      font-weight: 600;
      gap: 0.75rem;
      letter-spacing: -0.02em;
      margin: 0;
    }

    h3 span {
      color: var(--muted);
      font-family: var(--font-mono);
      font-size: 0.75rem;
      font-weight: 400;
    }

    p {
      line-height: 1.5;
      margin: 0;
    }
  }

  .looks {
    border-block-end: 3px solid var(--ink);
    display: grid;
    gap: 2rem;
    padding: 2.875rem var(--gutter);
  }

  .looks-intro {
    display: grid;
    gap: 1.25rem;
    max-inline-size: 48rem;

    h2 {
      font-size: clamp(2rem, 4vw, 3rem);
      font-weight: 600;
      letter-spacing: -0.03em;
      line-height: 1.02;
      margin: 0;
    }

    > p:not(.eyebrow) {
      font-size: 1.125rem;
      margin: 0;
    }
  }

  .look-grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /*
    Each card spans three rows of the list and takes them as a subgrid, so the
    titles, stages, and CSS toggles line up across a row of cards.
  */
  .look {
    background-color: var(--paper);
    border: 3px solid var(--ink);
    display: grid;
    gap: 0.75rem;
    grid-row: span 3;
    grid-template-rows: subgrid;
    /* A fixed track, so long lines of CSS scroll rather than widen the card. */
    grid-template-columns: minmax(0, 1fr);
    min-inline-size: 0;
    padding: 1.25rem;

    h3 {
      font-size: 1.375rem;
      margin: 0;
    }
  }

  /*
    White and light in either theme, so each look is seen on the background
    it was drawn for.
  */
  .look-stage {
    align-content: center;
    background-color: #fff;
    border: 1px solid var(--ink);
    color: var(--ink);
    color-scheme: light;
    display: grid;

    /*
      As tall as the tallest look, Brick, so the cards are the same size
      before Switch is registered, when the switches have no height.
    */
    min-block-size: 4.875rem;
    padding: 1.25rem 1rem;
  }

  .look-css {
    summary {
