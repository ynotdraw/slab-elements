---
import Guide from '../components/Guide.astro';
import { sections, summary, title } from '../lib/get-started.ts';

const base = import.meta.env.BASE_URL;
---

<Guide markdown="get-started.md" sections={sections} summary={summary} title={title}>
  <div class="ctas">
    <a class="button button--primary" href={`${base}components/`}>Browse the components</a>
    <a class="button" href="https://github.com/ynotdraw/slab-elements">View the source</a>
  </div>
</Guide>

<style>
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
</style>
