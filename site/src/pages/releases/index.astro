---
import PageActions from '../../components/PageActions.astro';
import Base from '../../layouts/Base.astro';
import { releases } from '../../lib/releases.ts';

const base = import.meta.env.BASE_URL;
const changelog = 'https://github.com/ynotdraw/slab-elements/blob/main/CHANGELOG.md';
const description = "Every release of Slab, newest first, with what's changed in each.";
---

<Base description={description} markdown="releases.md" title="Releases · Slab">
  <div class="page">
    <header class="intro">
      <p class="eyebrow">Changelog</p>
      <h1>Releases</h1>
      <p>
        {description} It's the package's
        <a href={changelog}>CHANGELOG.md</a>, and the bigger releases have a
        page of their own, with live examples.
      </p>
      <PageActions markdown="releases.md" />
    </header>

    <ol class="releases">
      {
        releases().map(({ announcement, changes, published, version }) => (
          <li class="release" id={`v${version}`}>
            <h2>
              <span>{version}</span>
              {!published && <span class="badge">Upcoming</span>}
            </h2>

            {announcement && (
              <a class="announcement" href={`${base}releases/${version}/`}>
                <strong>What's new in {version}</strong>
                <span>{announcement.summary}</span>
                {announcement.highlights.length > 0 && (
                  <ul class="new" aria-label="New">
                    {announcement.highlights.map(({ title }) => (
                      <li>{title}</li>
                    ))}
                  </ul>
                )}
              </a>
            )}

            {/*
              A release with a page of its own keeps its changes folded away,
              so the page stays a list of releases rather than of changes.
            */}
            {changes.length > 0 &&
              (announcement ? (
                <details class="all">
                  <summary>All {changes.length} changes</summary>
                  <ul class="changes">
                    {changes.map((html) => (
                      <li set:html={html} />
                    ))}
                  </ul>
                </details>
              ) : (
                <ul class="changes">
                  {changes.map((html) => (
                    <li set:html={html} />
                  ))}
                </ul>
              ))}
          </li>
        ))
      }
    </ol>
  </div>
</Base>

<style>
  .page {
    display: grid;
    gap: 3rem;
    margin-inline: auto;
    max-inline-size: 52rem;
    padding: 2.5rem var(--gutter) 4rem;
  }

  .intro {
    border-block-end: 4px solid var(--ink);
    display: grid;
    gap: 0.75rem;
    padding-block-end: 1.5rem;

    p:last-of-type {
      font-size: 1.25rem;
      margin: 0;
      max-inline-size: 52ch;
    }
  }

  h1 {
    font-size: clamp(2.5rem, 6vw, 3.75rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
    margin: 0;
  }

  .releases {
    display: grid;
    gap: 3rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .release {
    display: grid;
    gap: 1rem;
    scroll-margin-block-start: 1.5rem;
  }

  h2 {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    font-size: 1.75rem;
    gap: 0.75rem;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .badge {
    background-color: var(--ember);
    color: var(--paper);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0;
    padding: 0.25rem 0.5rem;
  }

  /* A card, raised as the site's buttons are, since the whole thing's a link. */
  .announcement {
    background-color: var(--paper);
    border: 2px solid var(--ink);
    border-inline-start: 8px solid var(--ember);
    box-shadow: 4px 4px 0 var(--ink);
    display: grid;
    gap: 0.25rem;
    padding: 1rem 1.25rem;
    text-decoration: none;
    transition:
      box-shadow 100ms ease-out,
      translate 100ms ease-out;

    strong {
      font-size: 1.25rem;
    }

    > span {
      color: var(--muted);
    }

    &:hover {
      background-color: var(--paper);
      box-shadow: 1px 1px 0 var(--ink);
      color: var(--ink);
      translate: 3px 3px;
    }
  }

  .new {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;

    li {
      border: 1px solid currentcolor;
      font-family: var(--font-mono);
      font-size: 0.6875rem;
      line-height: 1.6;
      padding: 0 0.4rem;
    }
  }

  .all summary {
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    inline-size: fit-content;
  }

  .all[open] summary {
    margin-block-end: 1rem;
  }

  .changes {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    max-inline-size: 70ch;
    padding-inline-start: 1.25rem;

    :global(.pr) {
      color: var(--muted);
      font-family: var(--font-mono);
      font-size: 0.8125rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .announcement {
      transition: none;
    }
  }
</style>
