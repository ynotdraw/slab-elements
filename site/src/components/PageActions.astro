---
// The page's Markdown twin, under its title: a button that copies it, for
// pasting into a chat with an LLM, and a link that opens it.

interface Props {
  // The twin, from the site's root, as Base's `markdown`.
  markdown: string;
}

const { markdown } = Astro.props;
const href = `${import.meta.env.BASE_URL}${markdown}`;
---

<div class="page-actions">
  <button class="copy-page" data-href={href} type="button">Copy page</button>
  <a href={href}>View as Markdown</a>
  <p aria-live="polite" class="visually-hidden" data-page-status></p>
</div>

<script>
  // Listened for on the document, since navigation swaps in each page. The
  // twin's fetched when the button's pressed rather than inlined, since it's
  // as long as the page. A ClipboardItem takes the fetch as a promise, so
  // Safari counts the write as part of the press; the browsers without one
  // write the text once it's in.
  document.addEventListener('click', async (event) => {
    const button =
      event.target instanceof Element ? event.target.closest<HTMLButtonElement>('.copy-page') : null;

    if (!button?.dataset.href) {
      return;
    }

    const status = button.parentElement?.querySelector('[data-page-status]');
    const text = fetch(button.dataset.href).then((response) => {
      if (!response.ok) {
        throw new Error(`${response.status} for ${response.url}`);
      }

      return response.text();
    });

    let copied = true;

    try {
      if (typeof ClipboardItem === 'function') {
        await navigator.clipboard.write([
          new ClipboardItem({
            'text/plain': text.then((value) => new Blob([value], { type: 'text/plain' })),
          }),
        ]);
      } else {
        await navigator.clipboard.writeText(await text);
      }
    } catch {
      copied = false;
    }

    button.textContent = copied ? 'Copied' : "Couldn't copy";

    if (status) {
      status.textContent = copied ? 'Copied the page as Markdown' : "Couldn't copy the page";
    }

    setTimeout(() => {
      button.textContent = 'Copy page';
    }, 2000);
  });
</script>

<style>
  .page-actions {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    gap: 0.5rem 1.25rem;
  }

  .copy-page {
    background-color: var(--ink);
    border: 0;
    color: var(--paper);
    cursor: pointer;
    font: inherit;
    /* So "Copied" doesn't shift the link beside it. */
    min-inline-size: 13ch;
    padding: 0.5rem 1rem;

    &:hover {
      background-color: var(--ember-deep);
    }
  }
</style>
