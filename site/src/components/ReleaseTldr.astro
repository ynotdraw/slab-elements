---
// A release's announcement as a TL;DR, for one too big to walk through a
// component at a time: its numbers, the short version, a tile per new
// component with its example live, and every fix on a line.
import { getEntry } from 'astro:content';
import { inline } from '../lib/prose.ts';
import { isPublished, type Announcement, type Tldr } from '../lib/releases.ts';
import CodeBlock from './CodeBlock.astro';
import PageActions from './PageActions.astro';

interface Props {
  announcement: Announcement & { tldr: Tldr };
}

const { highlights, intro, summary, tldr, version } = Astro.props.announcement;
const { additions, checks, fixes, points } = tldr;
const published = isPublished(version);
const base = import.meta.env.BASE_URL;

const page = async (component: string) => {
  const entry = await getEntry('components', component);

  if (!entry) {
    throw new Error(`There's no component page for "${component}".`);
  }

  return entry;
};

const tiles = await Promise.all(
  highlights.map(async (highlight) => {
    const entry = await page(highlight.component);

    return {
      ...highlight,
      example: highlight.example ?? entry.data.example,
      href: `${base}components/${entry.id}/`,
    };
  }),
);

const groups = await Promise.all(
  fixes.map(async (group) => ({
    ...group,
    fixes: await Promise.all(
      group.fixes.map(async (fix) => ({
        ...fix,
        components: await Promise.all(
          fix.components.map(async (component) => ({
            href: `${base}components/${component}/`,
            title: (await page(component)).data.title,
          })),
        ),
      })),
    ),
  })),
);

const fixed = new Set(fixes.flatMap((group) => group.fixes.flatMap((fix) => fix.components)));

const stats = [
  { label: 'new components', value: highlights.length },
  { label: 'accessibility fixes', value: fixes.flatMap((group) => group.fixes).length },
  { label: 'components fixed', value: fixed.size },
  { label: checks.length === 1 ? 'change to check' : 'changes to check', value: checks.length },
];
---

<article class="tldr">
  <header class="hero">
    <p class="eyebrow">What's new</p>
    <div class="title">
      <h1>{version}</h1>
      {!published && <span class="badge">Upcoming</span>}
    </div>
    <p class="summary">{summary}</p>
    <p class="intro" set:html={inline(intro)} />
    {
      !published && (
        <p class="note">
          {version} isn't on npm yet. This is what's in it, from <code>main</code>, ahead
          of the release.
        </p>
      )
    }
    <PageActions markdown={`releases/${version}.md`} />
  </header>

  <ul class="stats">
    {
      stats.map(({ label, value }) => (
        <li>
          <strong>{value}</strong>
          <span>{label}</span>
        </li>
      ))
    }
  </ul>

  <section aria-labelledby="short" class="short">
    <h2 id="short"><span class="label">TL;DR</span> The short version</h2>
    <ol>{points.map((point) => <li><span set:html={inline(point)} /></li>)}</ol>
  </section>

  <section aria-labelledby="components" class="block">
    <h2 id="components">New components</h2>
    <p class="lede">Every one is live below, styled the way this site styles them.</p>
    <ul class="tiles">
      {
        tiles.map(({ example, href, text, title, wide }) => (
          <li class:list={['tile', { wide }]}>
            <div class="stage" set:html={example} />
            <div class="caption">
              <h3>{title}</h3>
              <p set:html={inline(text)} />
              <a class="more" href={href}>
                Docs<span class="visually-hidden"> for {title}</span>
              </a>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="also" class="block">
    <h2 id="also">Also new</h2>
    <ul class="additions">
      {
        additions.map(({ href, text, title }) => (
          <li>
            <h3>
              <a href={`${base}${href}`}>{title}</a>
            </h3>
            <p set:html={inline(text)} />
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="fixes" class="block">
    <h2 id="fixes">Accessibility, everywhere</h2>
    <p class="lede">
      From an accessibility audit of every component. A line each, and the components it's
      in.
    </p>
    <div class="groups">
      {
        groups.map(({ fixes, title }) => (
          <section class="group">
            <h3>{title}</h3>
            <ul>
              {fixes.map(({ components, text }) => (
                <li>
                  <p set:html={inline(text)} />
                  <ul class="chips" aria-label="In">
                    {components.map(({ href, title }) => (
                      <li>
                        <a href={href}>{title}</a>
                      </li>
                    ))}
                  </ul>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </section>

  <section aria-labelledby="check" class="block">
    <h2 id="check">Before you upgrade</h2>
    <p class="lede">
      {
        checks.length === 1
          ? "One change can break what you have. It's why this is a minor release."
          : `${checks.length} changes can break what you have. They're why this is a minor release.`
      }
    </p>
    <ul class="checks">
      {
        checks.map(({ after, before, text, title }) => (
          <li>
            <h3>{title}</h3>
            <p set:html={inline(text)} />
            <div class="diff">
              <CodeBlock code={before} label="Before" lang="css" />
              <CodeBlock code={after} label="After" lang="css" />
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="upgrade" class="block upgrade">
    <h2 id="upgrade">Upgrade</h2>
    <CodeBlock code={`pnpm add slab-elements@${version}`} label="Install" lang="sh" />
    <p>
      {
        published ? (
          <>
            Every change, in full, is in{' '}
            <a href={`${base}releases/#v${version}`}>the release notes</a>.
          </>
        ) : (
          <>
            Every change, in full, will be in{' '}
            <a href={`${base}releases/`}>the release notes</a> once it's out.
          </>
        )
      }
    </p>
  </section>
</article>

<style>
  .tldr {
    display: grid;
    gap: 4rem;
    grid-template-columns: minmax(0, 1fr);
    margin-inline: auto;
    max-inline-size: 72rem;
    padding: 2.5rem var(--gutter) 5rem;
  }

  .hero {
    display: grid;
    gap: 1rem;

    p {
      margin: 0;
    }
  }

  .title {
    align-items: flex-start;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  h1 {
    font-size: clamp(5rem, 18vw, 11rem);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 0.85;
    margin: 0;
  }

  .badge {
    background-color: var(--ember);
    color: var(--paper);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    padding: 0.25rem 0.5rem;
  }

  .summary {
    font-size: clamp(1.375rem, 3vw, 1.875rem);
    letter-spacing: -0.01em;
    line-height: 1.25;
    max-inline-size: 30ch;
  }

  .intro {
    color: var(--muted);
    max-inline-size: 62ch;
  }

  .note {
    background-color: var(--paper);
    border: 2px solid var(--ink);
    border-inline-start: 8px solid var(--ember);
    max-inline-size: 62ch;
    padding: 0.75rem 1rem;
  }

  /* The numbers, on ink, a slab each, with the logo's ember course below. */
  .stats {
    background-color: var(--ink);
    border-block-end: 8px solid var(--ember);
    color: var(--paper);
    display: grid;
    gap: 1px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 9rem), 1fr));
    list-style: none;
    margin: 0;
    padding: 0;

    li {
      display: grid;
      gap: 0.25rem;
      outline: 1px solid var(--rule-on-ink);
      padding: clamp(1rem, 3vw, 1.5rem) clamp(1rem, 3vw, 1.75rem);
    }

    strong {
      font-size: clamp(3rem, 7vw, 4.5rem);
      font-weight: 600;
      letter-spacing: -0.04em;
      line-height: 1;
    }

    span {
      color: var(--dim);
      font-family: var(--font-mono);
      font-size: 0.8125rem;
    }
  }

  h2 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.1;
    margin: 0;
  }

  h3 {
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin: 0;
  }

  .label {
    background-color: var(--ember);
    color: var(--paper);
    font-family: var(--font-mono);
    font-size: 0.5em;
    font-weight: 500;
    letter-spacing: 0;
    margin-inline-end: 0.5rem;
    padding: 0.2em 0.5em;
    vertical-align: 0.35em;
  }

  .short {
    background-color: var(--paper);
    border: 3px solid var(--ink);
    box-shadow: 8px 8px 0 var(--ink);
    display: grid;
    gap: 1.25rem;
    padding: clamp(1.25rem, 4vw, 2.5rem);

    ol {
      counter-reset: point;
      display: grid;
      gap: 0.75rem;
      list-style: none;
      margin: 0;
      padding: 0;
    }

    li {
      align-items: baseline;
      counter-increment: point;
      display: grid;
      font-size: 1.1875rem;
      gap: 1rem;
      grid-template-columns: 2rem minmax(0, 1fr);

      &::before {
        color: var(--ember-deep);
        content: counter(point, decimal-leading-zero);
        font-family: var(--font-mono);
        font-size: 0.875rem;
        font-weight: 500;
      }
    }
  }

  .block {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: minmax(0, 1fr);
    scroll-margin-block-start: 1.5rem;
  }

  .lede {
    color: var(--muted);
    margin: -0.5rem 0 0;
    max-inline-size: 62ch;
  }

  .tiles {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: minmax(0, 1fr);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (width >= 48rem) {
    .tiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .wide {
      grid-column: 1 / -1;
    }
  }

  .tile {
    background-color: var(--paper);
    border: 3px solid var(--ink);
    display: grid;
    grid-template-rows: 1fr auto;
    min-inline-size: 0;
  }

  /*
    As on a component's page: room for the examples' hard shadows and their
    popups, and hidden until every element in it is defined.
  */
  .stage {
    align-content: center;
    background-color: var(--page);
    border-block-end: 3px solid var(--ink);
    display: grid;
    min-block-size: 11rem;
    overflow-x: auto;
    padding: 2rem clamp(1rem, 4vw, 2rem) 2.5rem;
    transition: opacity 150ms ease-out;
  }

  .stage:has(:not(:defined)) {
    opacity: 0;
  }

  .caption {
    align-items: baseline;
    display: grid;
    gap: 0.25rem 1rem;
    grid-template-columns: minmax(0, 1fr) auto;
    padding: 1rem 1.25rem 1.25rem;

    p {
      color: var(--muted);
      grid-column: 1 / -1;
      margin: 0;
    }
  }

  .more {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    grid-column: 2;
    grid-row: 1;

    &::after {
      content: ' →';
    }
  }

  .additions {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    list-style: none;
    margin: 0;
    padding: 0;

    li {
      border-block-start: 4px solid var(--ink);
      display: grid;
      gap: 0.5rem;
      align-content: start;
      padding-block-start: 1rem;
    }

    p {
      margin: 0;
    }
  }

  .groups {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
  }

  .group {
    align-content: start;
    background-color: var(--paper);
    border: 3px solid var(--ink);
    border-block-start: 10px solid var(--ember);
    display: grid;
    gap: 1rem;
    padding: 1.25rem;

    > ul {
      display: grid;
      gap: 1.25rem;
      list-style: none;
      margin: 0;
      padding: 0;
    }

    > ul > li {
      display: grid;
      gap: 0.5rem;
    }

    p {
      margin: 0;
    }
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    list-style: none;
    margin: 0;
    padding: 0;

    a {
      border: 1px solid var(--ink);
      display: block;
      font-family: var(--font-mono);
      font-size: 0.6875rem;
      line-height: 1.6;
      padding: 0 0.4rem;
      text-decoration: none;
    }
  }

  .checks {
    display: grid;
    gap: 2rem;
    list-style: none;
    margin: 0;
    padding: 0;

    li {
      border-inline-start: 8px solid var(--ember);
      display: grid;
      gap: 0.75rem;
      padding-inline-start: 1.25rem;
    }

    p {
      margin: 0;
      max-inline-size: 62ch;
    }
  }

  .diff {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
  }

  .upgrade {
    border-block-start: 4px solid var(--ink);
    padding-block-start: 2rem;

    p {
      margin: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stage {
      transition: none;
    }
  }
</style>
