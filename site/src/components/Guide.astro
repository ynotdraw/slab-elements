---
// A guide page: numbered sections, each with text, maybe code, and maybe more
// text after it, beside a sidebar of its sections. Get started and Upgrade to
// 1.0 are both one.
import { type Section, html } from '../lib/get-started.ts';
import Base from '../layouts/Base.astro';
import CodeBlock from './CodeBlock.astro';
import PageActions from './PageActions.astro';
import Sidebar from './Sidebar.astro';

type Props = {
  // The page's Markdown twin, such as "get-started.md".
  markdown: string;
  sections: Section[];
  summary: string;
  title: string;
};

const { markdown, sections, summary, title } = Astro.props;
const base = import.meta.env.BASE_URL;

// The sections, as the sidebar's one group.
const sidebar = [
  {
    heading: title,
    links: sections.map(({ heading, id }) => ({ href: `#${id}`, text: heading })),
  },
];
---


<Base description={summary} markdown={markdown} title={`${title} · Slab`}>
  <div class="layout">
    <Sidebar label="On this page" sections={sidebar} />

    <article class="doc">
      <header class="intro">
        <p class="eyebrow">Guide</p>
        <h1>{title}</h1>
        <p>{summary}</p>
        <PageActions markdown={markdown} />
      </header>

      {
        sections.map(({ code, coda, heading, id, points, stats, text }, index) => (
          <section aria-labelledby={id} class="step">
            <h2 id={id}>
              <span>{String(index + 1).padStart(2, '0')}</span> {heading}
            </h2>
            <p set:html={html(text, base)} />
            {stats && (
              <ul class="stats">
                {stats.map(({ label, value }) => (
                  <li>
                    <strong>{value}</strong>
                    <span>{label}</span>
                  </li>
                ))}
              </ul>
            )}
            {points && (
              <ul class="points">
                {points.map(({ text, title }) => (
                  <li>
                    <h3>{title}</h3>
                    <p set:html={html(text, base)} />
                  </li>
                ))}
              </ul>
            )}
            {code && <CodeBlock code={code.code} label={code.label} lang={code.lang} />}
            {coda && <p set:html={html(coda, base)} />}
          </section>
        ))
      }

      <slot />
    </article>
  </div>
</Base>

<style>
  /* The same layout as a component's page, the sidebar beside it. */
  .layout {
    display: grid;
    gap: 1rem 3rem;
    grid-template-columns: minmax(0, 1fr);
    margin-inline: auto;
    max-inline-size: 78rem;
    padding: 1.5rem var(--gutter) 4rem;
  }

  @media (width >= 56rem) {
    .layout {
      grid-template-columns: 12rem minmax(0, 1fr);
    }
  }

  .doc {
    display: grid;
    gap: 3rem;
    grid-template-columns: minmax(0, 46rem);
    min-inline-size: 0;
  }

  .intro {
    border-block-end: 4px solid var(--ink);
    display: grid;
    gap: 0.75rem;
    padding-block-end: 1.5rem;

    p:last-of-type {
      font-size: 1.25rem;
      margin: 0;
      max-inline-size: 52ch;
    }
  }

  h1 {
    font-size: clamp(2.5rem, 6vw, 3.75rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
    margin: 0;
  }

  .step {
    display: grid;
    gap: 1rem;
    min-inline-size: 0;
    scroll-margin-block-start: 1.5rem;

    h2 {
      font-size: 1.625rem;
      letter-spacing: -0.02em;
      line-height: 1.1;
      margin: 0;
    }

    h2 span {
      color: var(--muted);
      font-family: var(--font-mono);
      font-size: 0.875rem;
      font-weight: 400;
      margin-inline-end: 0.25rem;
    }

    p {
      margin: 0;
    }
  }

  /* Numbers, each large over its label, as on a release's page. */
  .stats {
    background-color: var(--ink);
    border-block-end: 8px solid var(--ember);
    color: var(--paper);
    display: grid;
    gap: 1px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    list-style: none;
    margin: 0;
    padding: 0;

    @media (width >= 40rem) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    li {
      align-content: start;
      display: grid;
      gap: 0.25rem;
      outline: 1px solid var(--rule-on-ink);
      padding: 1.25rem clamp(1rem, 3vw, 1.5rem);
    }

    strong {
      font-size: clamp(1.75rem, 5vw, 2.75rem);
      font-weight: 600;
      letter-spacing: -0.03em;
      line-height: 1;
      white-space: nowrap;
    }

    span {
      color: var(--dim);
      font-family: var(--font-mono);
      font-size: 0.8125rem;
    }
  }

  /* Tiles, each a short title over a sentence. */
  .points {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    list-style: none;
    margin: 0;
    padding: 0;

    li {
      align-content: start;
      background-color: var(--paper);
      border: 3px solid var(--ink);
      border-block-start: 10px solid var(--ember);
      display: grid;
      gap: 0.5rem;
      padding: 1rem 1.25rem 1.25rem;
    }

    h3 {
      font-size: 1.1875rem;
      font-weight: 600;
      letter-spacing: -0.01em;
      margin: 0;
    }
  }
</style>
