---
// A card per showcase theme, each with a swatch drawn in that theme's own
// colors. Used by the showcase index and the homepage.
import { showcases } from '../lib/showcases.ts';

const base = import.meta.env.BASE_URL;
---

<ul class="cards">
  {
    showcases.map((showcase) => (
      <li class={`card card--${showcase.slug}`}>
        <a href={`${base}showcase/${showcase.slug}/`}>
          <span aria-hidden="true" class="swatch" />
          <span class="title">{showcase.title}</span>
          <span class="summary">{showcase.summary}</span>
          <span class="count">{showcase.elements.length} elements</span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .cards {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .card a {
    background-color: var(--paper);
    border: 3px solid var(--ink);
    box-shadow: 6px 6px 0 var(--ink);
    display: grid;
    gap: 0.5rem;
    block-size: 100%;
    box-sizing: border-box;
    padding: 0 0 1.25rem;
    text-decoration: none;
    transition: box-shadow 150ms ease-out;

    &:hover {
      background-color: var(--paper);
      box-shadow: 6px 6px 0 var(--ember);
      color: var(--ink);
    }
  }

  .swatch {
    block-size: 8rem;
    border-block-end: 3px solid var(--ink);
    display: block;
  }

  .title,
  .summary,
  .count {
    padding-inline: 1.25rem;
  }

  .title {
    font-size: 1.5rem;
    font-weight: 700;
    margin-block-start: 0.5rem;
  }

  .summary {
    font-family: var(--font-body);
    font-size: 0.9375rem;
  }

  .count {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  /* A taste of each theme, drawn in its own colors. */
  .card--cyberpunk .swatch {
    background:
      linear-gradient(90deg, #00f0ff 0 30%, transparent 30%) 1.25rem 70% / 60% 4px no-repeat,
      linear-gradient(90deg, #ff2bd6, #ff2bd6) 1.25rem 45% / 35% 1.25rem no-repeat,
      radial-gradient(circle at 85% 0%, rgb(255 43 214 / 35%), transparent 55%),
      #07060d;
  }

  .card--finance .swatch {
    background:
      linear-gradient(#1f4fd1, #1f4fd1) 1.25rem 40% / 40% 0.75rem no-repeat,
      linear-gradient(#dfe4ec, #dfe4ec) 1.25rem 62% / 70% 0.5rem no-repeat,
      linear-gradient(#dfe4ec, #dfe4ec) 1.25rem 78% / 55% 0.5rem no-repeat,
      #f3f5f9;
  }

  .card--studio .swatch {
    background:
      radial-gradient(circle, #b5532f 0 1.1rem, transparent 1.15rem) 22% 50% / 3rem 3rem no-repeat,
      radial-gradient(circle, #5f7f62 0 1.1rem, transparent 1.15rem) 45% 50% / 3rem 3rem no-repeat,
      radial-gradient(circle, #eadfd1 0 1.1rem, transparent 1.15rem) 68% 50% / 3rem 3rem no-repeat,
      #fbf5ec;
  }

  .card--rpg .swatch {
    background:
      linear-gradient(#fff, #fff) 1.25rem 70% / 45% 0.4rem no-repeat,
      linear-gradient(#5ad17a, #5ad17a) 1.25rem 70% / 30% 0.4rem no-repeat,
      linear-gradient(180deg, #2b4fb8, #0b1650);
    box-shadow: inset 0 0 0 4px #0b1650, inset 0 0 0 6px #e8ecff;
  }
</style>
