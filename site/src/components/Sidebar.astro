---
// A page's side navigation: groups of links, each under a heading. Below a
// tablet's width it folds into a disclosure above the page, so the page comes
// first.

interface Props {
  // Names the navigation, and is the disclosure's summary on narrow screens.
  label: string;

  sections: {
    heading: string;
    links: { current?: boolean; href: string; text: string }[];
  }[];
}

const { label, sections } = Astro.props;
---

<details class="sidebar" open>
  <summary>{label}</summary>

  <nav aria-label={label}>
    {
      sections.map(({ heading, links }) => (
        <section>
          <h2>{heading}</h2>
          <ul>
            {links.map(({ current, href, text }) => (
              <li>
                <a aria-current={current ? 'page' : undefined} href={href}>
                  {text}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </nav>
</details>

<script>
  // Closed on narrow screens, where it sits above the page rather than
  // beside it. Open by default, so it's open with no script. On every page,
  // since each navigation brings a new one.
  document.addEventListener('astro:page-load', () => {
    const sidebar = document.querySelector<HTMLDetailsElement>('.sidebar');

    if (sidebar && matchMedia('(width < 56rem)').matches) {
      sidebar.open = false;
    }
  });
</script>

<style>
  .sidebar {
    align-self: start;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  summary {
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 0.75rem 0;
  }

  @media (width >= 56rem) {
    .sidebar {
      inset-block-start: 1.5rem;
      max-block-size: calc(100dvh - 3rem);
      overflow-y: auto;
      position: sticky;
    }

    summary {
      display: none;
    }
  }

  nav {
    display: grid;
    gap: 1.25rem;
  }

  h2 {
    border-block-end: 2px solid var(--ink);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    margin: 0 0 0.375rem;
    padding-block-end: 0.375rem;
  }

  ul {
    display: grid;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  a {
    border-inline-start: 4px solid transparent;
    display: block;
    padding: 0.25rem 0.5rem;
    text-decoration: none;
  }

  a[aria-current='page'] {
    background-color: var(--ink);
    border-inline-start-color: var(--ember);
    color: var(--paper);
  }
</style>
