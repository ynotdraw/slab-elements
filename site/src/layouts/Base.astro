---
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import { version } from '../../../package.json';
import Logo from '../components/Logo.astro';
import '../styles/global.css';

interface Props {
  description: string;

  // The page's Markdown twin, from the site's root, for llms.txt readers. The
  // 404 page has none.
  markdown?: string;

  title: string;
}

const { description, markdown, title } = Astro.props;
const base = import.meta.env.BASE_URL;
const github = 'https://github.com/ynotdraw/slab-elements';

// The menu's links mark the page they're on.
const current = (href: string) => (Astro.url.pathname === href ? 'page' : undefined);

// Absolute, from `site`, for search engines and link previews. Each page's
// card is drawn by `og/generate.js`, named for the page: "index" for the home
// page, and its path otherwise, as "components/alert".
const canonical = new URL(Astro.url.pathname, Astro.site);
const page = Astro.url.pathname.slice(base.length).replace(/\/$/, '') || 'index';

// The 404 page has no card of its own, and shows the home page's.
const image = new URL(`${base}og/${page === '404' ? 'index' : page}.png`, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1" name="viewport" />
    <meta content={description} name="description" />
    <title>{title}</title>
    <link href={canonical} rel="canonical" />
    <meta content="Slab" property="og:site_name" />
    <meta content="website" property="og:type" />
    <meta content={title} property="og:title" />
    <meta content={description} property="og:description" />
    <meta content={canonical} property="og:url" />
    <meta content={image} property="og:image" />
    <meta content="1200" property="og:image:width" />
    <meta content="630" property="og:image:height" />
    <meta content={`${title}. ${description}`} property="og:image:alt" />
    <meta content="summary_large_image" name="twitter:card" />
    <meta content={title} name="twitter:title" />
    <meta content={description} name="twitter:description" />
    <meta content={image} name="twitter:image" />
    {
      markdown && (
        <link
          href={`${base}${markdown}`}
          rel="alternate"
          title="This page as Markdown"
          type="text/markdown"
        />
      )
    }
    <link href={`${base}favicon.ico`} rel="icon" sizes="16x16 32x32 48x48" />
    <link href={`${base}favicon-32.png`} rel="icon" sizes="32x32" type="image/png" />
    <link href={`${base}apple-touch-icon.png`} rel="apple-touch-icon" />
    <!--
      The fonts, from astro.config.mjs. Only the faces nearly every page shows
      above the fold are preloaded: the body text, the headings and the code.
    -->
    <Font cssVariable="--font-display" preload={[{ weight: 400 }, { weight: 600 }]} />
    <Font cssVariable="--font-mono" preload={[{ weight: 400 }]} />
    <Font cssVariable="--font-body" />
    <!-- Before the first paint, so a saved theme never flashes the OS's. -->
    <script is:inline>
      try {
        const theme = localStorage.getItem('theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {}

      // On a phone, the header folds its links into a menu, which needs a
      // script. Set before the first paint, so the links don't show and then
      // fold, and left off without a script, so they stay.
      document.documentElement.dataset.menu = '';
    </script>
    <!--
      Navigation swaps the page in place, so the elements a page has
      registered stay registered on the next, and the header stays put.
    -->
    <ClientRouter />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="header">
      <a aria-label="Slab, home" class="brand home" href={base}>
        <Logo />
        <span>Slab</span>
      </a>

      <!--
        On a phone, the mark is the menu button in the name's place. Its three
        courses read as a menu's bars. "Slab menu" starts with what it shows.
      -->
      <button
        aria-controls="menu"
        aria-expanded="false"
        aria-haspopup="dialog"
        class="brand menu"
        type="button"
      >
        <Logo />
        <span>Slab</span>
        <span class="visually-hidden">menu</span>
      </button>

      <nav aria-label="Site">
        <ul>
          <li><a href={`${base}get-started/`}>Get started</a></li>
          <li><a href={`${base}components/`}>Components</a></li>
          <li><a href={`${base}showcase/`}>Showcase</a></li>
          <li><a href={`${base}#why`}>Why headless</a></li>
          <li><a class="release" href="https://www.npmjs.com/package/slab-elements">v{version}</a></li>
          <li><a class="github" href={github}>GitHub</a></li>
        </ul>
      </nav>

      <!-- Hidden until the script below can make it work. -->
      <button aria-pressed="false" class="theme" hidden type="button">
        <svg aria-hidden="true" class="moon" height="16" viewBox="0 0 16 16" width="16">
          <path d="M6 1.5a6.5 6.5 0 1 0 8.5 8.5A5.5 5.5 0 0 1 6 1.5Z" fill="currentColor" />
        </svg>
        <svg aria-hidden="true" class="sun" height="16" viewBox="0 0 16 16" width="16">
          <circle cx="8" cy="8" fill="currentColor" r="3.25" />
          <path
            d="M8 .75v2M8 13.25v2M.75 8h2M13.25 8h2M2.87 2.87l1.42 1.42M11.71 11.71l1.42 1.42M2.87 13.13l1.42-1.42M11.71 4.29l1.42-1.42"
            stroke="currentColor"
            stroke-linecap="square"
            stroke-width="1.5"
          />
        </svg>
        <span class="visually-hidden">Dark theme</span>
      </button>
    </header>

    <!--
      The phone's menu: a modal Slab Dialog that slides in from the side, so
      focus stays in it, Escape closes it, and focus goes back to the button.
      A click on the backdrop closes it where the browser supports that.
    -->
    <slab-dialog class="drawer" closedby="any" hide-label id="menu" label="Menu">
      <div class="drawer-head">
        <a aria-label="Slab, home" aria-current={current(base)} class="brand" href={base}>
          <Logo />
          <span>Slab</span>
        </a>

        <form method="dialog">
          <button class="close" type="submit">
            <svg aria-hidden="true" height="14" viewBox="0 0 14 14" width="14">
              <path d="M1 1l12 12M13 1 1 13" stroke="currentColor" stroke-width="2" />
            </svg>
            Close
          </button>
        </form>
      </div>

      <nav aria-label="Site">
        <ul class="primary">
          <li>
            <a aria-current={current(`${base}get-started/`)} href={`${base}get-started/`}>
              Get started
            </a>
          </li>
          <li>
            <a aria-current={current(`${base}components/`)} href={`${base}components/`}>
              Components
            </a>
          </li>
          <li>
            <a aria-current={current(`${base}showcase/`)} href={`${base}showcase/`}>Showcase</a>
          </li>
          <li><a href={`${base}#why`}>Why headless</a></li>
          <li>
            <a aria-current={current(`${base}releases/`)} href={`${base}releases/`}>Releases</a>
          </li>
          <li>
            <a aria-current={current(`${base}accessibility/`)} href={`${base}accessibility/`}>
              Accessibility
            </a>
          </li>
        </ul>

        <ul class="secondary">
          <li><a href={`${base}llms.txt`}>llms.txt</a></li>
          {markdown && <li><a href={`${base}${markdown}`}>This page as Markdown</a></li>}
          <li><a href="https://www.npmjs.com/package/slab-elements">npm v{version}</a></li>
          <li><a href={github}>GitHub</a></li>
        </ul>
      </nav>
    </slab-dialog>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="footer">
      <a aria-label="Slab, home" class="brand" href={base}>
        <Logo size={26} />
        <span>Slab</span>
      </a>

      <ul>
        <li><a href={`${base}get-started/`}>Get started</a></li>
        <li><a href={`${base}components/`}>Components</a></li>
        <li><a href={`${base}showcase/`}>Showcase</a></li>
        <li><a href={`${base}releases/`}>Releases</a></li>
        <li><a href={`${base}accessibility/`}>Accessibility</a></li>
        <li><a href={`${base}llms.txt`}>llms.txt</a></li>
        {markdown && <li><a href={`${base}${markdown}`}>This page as Markdown</a></li>}
        <li><a href={github}>GitHub</a></li>
        <li>Apache-2.0</li>
      </ul>
    </footer>
  </body>
</html>

<script>
  import type Dialog from '../../../src/dialog.ts';

  // The menu is a Slab Dialog. Imported for its registration alone, which a
  // plain `import` would lose, since `src` isn't in the package's side effects.
  void import('../../../src/dialog.ts');

  // The OS's preference until someone presses the toggle, then theirs, kept
  // in local storage. The head's inline script applies it on later visits.
  const query = matchMedia('(prefers-color-scheme: dark)');
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
  const root = document.documentElement;

  const isDark = () => (root.dataset.theme ?? (query.matches ? 'dark' : 'light')) === 'dark';

  const sync = () =>
    document.querySelector('.theme')?.setAttribute('aria-pressed', String(isDark()));

  // A navigation swaps in the next page's root, which has no theme of its own,
  // and its toggle, which is hidden and unpressed. They're set before the swap,
  // so the toggle neither blinks out nor turns its icons.
  document.addEventListener('astro:before-swap', ({ newDocument }) => {
    if (root.dataset.theme) {
      newDocument.documentElement.dataset.theme = root.dataset.theme;
    }

    // The next page's root hasn't run the head's script, which folds the
    // header's links into the menu.
    newDocument.documentElement.dataset.menu = '';

    const button = newDocument.querySelector<HTMLButtonElement>('.theme');

    if (button) {
      button.setAttribute('aria-pressed', String(isDark()));
      button.hidden = false;
    }
  });

  // Once per page, since each navigation brings a new header.
  document.addEventListener('astro:page-load', () => {
    const button = document.querySelector<HTMLButtonElement>('.theme')!;

    button.addEventListener('click', () => {
      const theme = isDark() ? 'light' : 'dark';

      try {
        localStorage.setItem('theme', theme);
      } catch {}

      const apply = () => {
        root.dataset.theme = theme;
        sync();
      };

      // The page cross-fades between themes where it can, and snaps where it
      // can't or motion's reduced.
      if (document.startViewTransition && !reduceMotion.matches) {
        document.startViewTransition(apply);
      } else {
        apply();
      }
    });

    sync();
    button.hidden = false;

    setUpMenu();
  });

  // The phone's menu. Its button says whether it's open, and it closes when
  // one of its links is followed, since "Why headless" can be on this page, and
  // when the window widens past where the header has room for the links.
  const wide = matchMedia('(width >= 40rem)');

  const setUpMenu = () => {
    const button = document.querySelector<HTMLButtonElement>('.menu')!;
    const menu = document.querySelector<Dialog>('#menu')!;

    button.addEventListener('click', () => menu.show());

    menu.addEventListener('toggle', (event) => {
      button.setAttribute('aria-expanded', String(event.newState === 'open'));
    });

    menu.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a')) {
        menu.close();
      }
    });
  };

  wide.addEventListener('change', () => {
    if (wide.matches) {
      document.querySelector<Dialog>('#menu')?.close();
    }
  });

  query.addEventListener('change', sync);
</script>

<style>
  .skip {
    background-color: var(--ink);
    color: var(--paper);
    font-family: var(--font-mono);
    inset-block-start: 0;
    inset-inline-start: 0;
    padding: 0.75rem 1rem;
    position: absolute;

    /* Clear of the page, shadow and all, until it's focused. */
    translate: 0 -200%;
    z-index: 1;

    &:focus-visible {
      translate: none;
    }
  }

  main:focus {
    outline: none;
  }

  .header {
    align-items: center;
    background-color: var(--paper);
    border-block-end: 3px solid var(--ink);
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    padding: 0.875rem var(--gutter);
  }

  .brand {
    align-items: center;
    display: flex;
    font-size: 1.5rem;
    gap: 0.75rem;
    letter-spacing: -0.02em;
    text-decoration: none;

    &:hover {
      background: none;
      color: inherit;
    }
  }

  .header nav {
    margin-inline-start: auto;
  }

  .header nav ul,
  .footer ul {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
    white-space: nowrap;
  }

  .header nav a {
    border-block-end: 2px solid transparent;
    display: inline-block;
    padding-block: 0.25rem;
    text-decoration: none;

    &:hover {
      background: none;
      border-block-end-color: var(--ember);
      color: var(--ink);
    }
  }

  /* The package's version, from its package.json, so it's current every release. */
  .header .release {
    color: var(--muted);
  }

  .header .github {
    background-color: var(--ink);
    border: 0;
    color: var(--paper);
    padding: 0.5rem 0.875rem;

    &:hover {
      background-color: var(--ember-deep);
      color: var(--paper);
    }
  }

  /*
    A moon to turn the dark theme on, and a sun to turn it off. They share a
    cell, so one turns in as the other turns out.
  */
  .theme {
    background: none;
    border: 2px solid var(--ink);
    color: var(--ink);
    cursor: pointer;
    display: inline-grid;
    padding: 0.375rem;

    /* Out of the page's cross-fade, so its own icons can turn. */
    view-transition-name: theme-toggle;
    transition:
      background-color 150ms ease-out,
      color 150ms ease-out,
      scale 150ms ease-out;

    &:hover {
      background-color: var(--ink);
      color: var(--paper);
    }

    &:active {
      scale: 0.9;
      transition-duration: 50ms;
    }

    &:focus-visible {
      outline: 3px solid var(--ember);
      outline-offset: 2px;
    }
  }

  .theme svg {
    grid-area: 1 / 1;
    transition:
      opacity 300ms ease-out,
      rotate 300ms ease-out,
      scale 300ms ease-out;
  }

  .theme[hidden] {
    display: none;
  }

  .theme[aria-pressed='true'] .moon,
  .theme[aria-pressed='false'] .sun {
    opacity: 0;
    rotate: -90deg;
    scale: 0.5;
  }

  :global(::view-transition-old(theme-toggle)) {
    display: none;
  }

  :global(::view-transition-new(theme-toggle)) {
    animation: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .theme,
    .theme svg {
      transition: none;
    }
  }

  /*
    On a phone, the mark becomes the menu button and the links fold into the
    menu. Without a script, there's no menu, and the links go on a row of
    their own under the name.
  */
  .menu {
    background: none;
    border: 0;
    color: inherit;
    cursor: pointer;
    display: none;
    font: inherit;
    font-size: 1.5rem;
    margin: -0.25rem;
    padding: 0.25rem;

    &:focus-visible {
      outline: 3px solid var(--ember);
      outline-offset: 2px;
    }
  }

  @media (width < 40rem) {
    :global(:root[data-menu]) {
      .home,
      .header > nav {
        display: none;
      }

      .menu {
        display: flex;
      }

      .theme {
        margin-inline-start: auto;
      }
    }

    .header nav {
      inline-size: 100%;
      margin-inline-start: 0;
    }

    .header nav ul {
      gap: 0.75rem 1.25rem;
    }
  }

  /*
    The menu: a sheet from the start edge, over a dimmed page that can't be
    scrolled behind it. It slides in and out where motion's welcome.
  */
  /* Without a script, the menu's never defined, and its links stay out of the way. */
  .drawer:not(:defined) {
    display: none;
  }

  .drawer::part(dialog) {
    background-color: var(--paper);
    block-size: 100dvh;
    border: 0;
    border-inline-end: 3px solid var(--ink);
    box-sizing: border-box;
    color: var(--ink);
    inline-size: min(20rem, 85vw);
    inset-block: 0;
    inset-inline: 0 auto;
    margin: 0;
    max-block-size: none;
    max-inline-size: none;
    overflow-y: auto;
    padding: 0.875rem var(--gutter) 2rem;
    transition:
      display 250ms allow-discrete,
      overlay 250ms allow-discrete,
      translate 250ms ease-out;
    translate: -100% 0;
  }

  .drawer[open]::part(dialog) {
    translate: none;

    @starting-style {
      translate: -100% 0;
    }
  }

  .drawer::part(dialog)::backdrop {
    background-color: rgb(0 0 0 / 0);
    transition:
      background-color 250ms ease-out,
      display 250ms allow-discrete,
      overlay 250ms allow-discrete;
  }

  .drawer[open]::part(dialog)::backdrop {
    background-color: rgb(0 0 0 / 0.45);

    @starting-style {
      background-color: rgb(0 0 0 / 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .drawer::part(dialog),
    .drawer::part(dialog)::backdrop {
      transition: none;
    }
  }

  :global(:root:has(#menu[open])) {
    overflow: hidden;
  }

  .drawer-head {
    align-items: center;
    border-block-end: 3px solid var(--ink);
    display: flex;
    justify-content: space-between;
    margin-block-end: 1.5rem;
    margin-inline: calc(-1 * var(--gutter));
    padding: 0 var(--gutter) 0.875rem;
  }

  .close {
    align-items: center;
    background: none;
    border: 2px solid var(--ink);
    color: var(--ink);
    cursor: pointer;
    display: inline-flex;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    gap: 0.5rem;
    padding: 0.375rem 0.625rem;

    &:hover {
      background-color: var(--ink);
      color: var(--paper);
    }

    &:focus-visible {
      outline: 3px solid var(--ember);
      outline-offset: 2px;
    }
  }

  .drawer nav {
    display: grid;
    gap: 1.75rem;
  }

  .drawer ul {
    display: grid;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .drawer a {
    border-inline-start: 4px solid transparent;
    display: block;
    padding: 0.5rem 0.75rem;
    text-decoration: none;

    &:hover {
      background: none;
      border-inline-start-color: var(--ember);
      color: var(--ink);
    }
  }

  .drawer .primary {
    font-family: var(--font-display);
    font-size: 1.375rem;
  }

  .drawer .secondary {
    border-block-start: 2px solid var(--ink);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    padding-block-start: 1rem;

    a {
      padding-block: 0.375rem;
    }
  }

  .drawer a[aria-current='page'] {
    background-color: var(--ink);
    border-inline-start-color: var(--ember);
    color: var(--paper);
  }

  .drawer-head .brand {
    border: 0;
    display: flex;
    padding: 0;

    &:hover {
      color: var(--ink);
    }
  }

  .footer {
    align-items: center;
    background-color: var(--ink);
    color: var(--paper);
    /* Ink in either theme, to close the page. */
    color-scheme: light;
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    padding: 2rem var(--gutter);

    .brand {
      color: var(--paper);
      font-size: 1.3rem;
    }

    ul {
      flex-wrap: wrap;
      gap: 1.375rem;
      margin-inline-start: auto;
    }

    li:last-child {
      color: var(--dim);
    }

    a {
      color: var(--paper);
      text-decoration: none;

      &:hover {
        background: none;
        color: var(--paper);
        text-decoration: underline;
        text-decoration-color: var(--ember);
      }
    }
  }

  .footer .brand {
    color: var(--paper);
  }
</style>
