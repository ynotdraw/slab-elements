// The site, as a Worker that serves only static assets: the built `dist`, at
// slab-elements.dev. Workers Builds deploys it on every push to main, and
// uploads a preview version for every other branch. It finds this Worker by
// `name`.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "slab-elements",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
  "routes": [{ "pattern": "slab-elements.dev", "custom_domain": true }],

  // Production is served at its own domain only, with no workers.dev address.
  // Preview URLs are on so Workers Builds can link a pull request's branch to
  // a preview of the site. They serve only versions that aren't deployed.
  "workers_dev": false,
  "preview_urls": true,

  // Workers Builds runs `wrangler preview` for branches other than main, which
  // needs this block even when it's empty. The top-level settings above apply
  // to previews as well.
  "previews": {},

  // As Storybook's is in the root's scripts.
  "send_metrics": false,
}
